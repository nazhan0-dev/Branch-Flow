# การเชื่อมต่อ MySQL 8
DATABASE_URL=mysql://root:password@localhost:3306/branch_logistics

# คีย์สำหรับเซ็น JWT — ตั้งเป็นข้อความสุ่มยาว ๆ
SECRET=change-me-to-a-long-random-string

PORT=8000
# หน้าเว็บที่อนุญาตให้เรียก API (คั่นหลายที่ด้วย ,)
CLIENT_URL=http://localhost:5173

# คีย์ที่เครื่อง POS (หรือตัวจำลอง POS) ใช้ส่งยอดขายผ่าน header X-POS-Key
POS_API_KEY=pos-demo-key

# ร่างคำขออัตโนมัติจะถูกส่งเข้าคลังเองหลังกี่นาที ถ้าสาขาไม่ยืนยัน
AUTO_SUBMIT_MINUTES=120

# รหัสผ่านของบัญชีตัวอย่างที่ npm run db:reset สร้าง
DEMO_PASSWORD=Demo@1234

# production: cookie ส่งผ่าน HTTPS เท่านั้น
NODE_ENV=development

# SameSite ของ cookie ล็อกอิน: lax (ค่าเริ่มต้น) | strict | none
#   lax  = หน้าเว็บกับ API อยู่ site เดียวกัน เช่น localhost:5173 + localhost:8000 หรือ app.example.com + api.example.com
#   none = หน้าเว็บกับ API อยู่คนละโดเมน (เช่น xxx.vercel.app + yyy.onrender.com) ต้องเปิดผ่าน HTTPS ทั้งคู่
# COOKIE_SAMESITE=lax
